---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** Absolute or root-relative image for social cards. */
  image?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = 'Rajarshi Lahiri — projects, photography, and a reading list.',
  image = '/img/photo.jpg',
  type = 'website',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const fullTitle = title === 'home' ? 'Rajarshi Lahiri' : `${title} — Rajarshi Lahiri`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f3ed" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/img/favicon.svg" type="image/svg+xml" />

    {/*
      The font used to be an @import at the top of global.css, which is the
      slowest way to ask for one: the browser has to download and parse the
      stylesheet before it even learns the font exists. From here the request
      starts with the document, and the preconnects open the two connections
      it needs while the HTML is still arriving.

      Only the three weights the site actually sets. The italic that used to be
      requested here is not used anywhere in the build.
    */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&display=swap"
    />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@rajarshi_lahiri" />

    <script src="/js/dither.js" defer is:inline></script>

    <slot name="head" />
  </head>

  <body>
    <!-- Decorative: the same five inks as the photographs, used as ground.
         Painted by dither.js; absent and harmless without JS. -->
    <canvas class="page-field" aria-hidden="true"></canvas>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
