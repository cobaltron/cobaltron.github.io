---
import Base from './Base.astro';

interface Props {
  title: string;
  summary?: string;
  meta?: string[];
}

const { title, summary, meta = [] } = Astro.props;
---

<Base title={title} description={summary} type="article">
  <article>
    <div class="container container--read">
      <header class="entry-header">
        <h1 class="entry-title">{title}</h1>
        {summary && <p class="entry-summary">{summary}</p>}
        {meta.length > 0 && (
          <p class="entry-meta">{meta.map((item) => <span>{item}</span>)}</p>
        )}
      </header>

      <div class="prose">
        <slot />
      </div>

      <p class="back">
        <a href="/projects">← All projects</a>
      </p>
    </div>
  </article>
</Base>

<style>
  .back {
    margin: clamp(3rem, 7vw, 4.5rem) 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: var(--t-xs);
  }
</style>
