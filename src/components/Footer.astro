---
const year = new Date().getFullYear();

const elsewhere = [
  { href: 'https://github.com/cobaltron/', label: 'GitHub' },
  { href: 'https://www.linkedin.com/in/rajarshi-lahiri-94a103134/', label: 'LinkedIn' },
  { href: 'https://twitter.com/rajarshi_lahiri', label: 'Twitter' },
  { href: '/CV_Rajarshi%20Lahiri.pdf', label: 'CV' },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-bar">
      <p style="margin:0">© {year} Rajarshi Lahiri · dithered in canvas</p>
      <div class="footer-links">
        {elsewhere.map((item) => (
          <a
            href={item.href}
            rel={item.href.startsWith('http') ? 'me noopener' : undefined}
            target={item.href.startsWith('http') ? '_blank' : undefined}
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
