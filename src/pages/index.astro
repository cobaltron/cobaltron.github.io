---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { STAGE_META } from '../content.config';
import { formatDate, isoDate } from '../lib/format';

const published = <T extends { data: { draft: boolean } }>(items: T[]) =>
  items.filter((i) => import.meta.env.DEV || !i.data.draft);

const allNotes = published(await getCollection('notes'));
const tendedAt = (n: (typeof allNotes)[number]) =>
  (n.data.tended ?? n.data.planted).getTime();

const notes = [...allNotes].sort((a, b) => tendedAt(b) - tendedAt(a)).slice(0, 5);

const allPosts = published(await getCollection('posts')).sort(
  (a, b) => b.data.published.getTime() - a.data.published.getTime()
);
const posts = allPosts.slice(0, 3);

const allProjects = published(await getCollection('projects'));
const projects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const allLinks = published(await getCollection('links')).sort(
  (a, b) => b.data.added.getTime() - a.data.added.getTime()
);
const links = allLinks.slice(0, 3);

---

<Base title="home">
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div>
          <h1>Rajarshi Lahiri</h1>
          <p class="hero-lead">
            I build Salesforce and applied-AI systems, and I write here while I am
            still working things out. Every note below carries a growth stage, so you
            can see how settled each one is before you read it.
          </p>
          <p class="routes">
            <a href="/notes">Read the notes</a>
            <a href="/projects">See the work</a>
          </p>
        </div>
        <div class="portrait">
          <img
            src="/img/photo.jpg"
            alt="Rajarshi Lahiri"
            width="240"
            height="240"
            data-dither="portrait"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Notes ============ -->
  {
    notes.length > 0 && (
      <section class="band">
        <div class="container">
          <h2>Growing</h2>
          <p class="band-note">
            Notes get revised. The stem beside each one says how settled it is.
          </p>

          <ol class="index">
            {notes.map((note) => {
              const when = note.data.tended ?? note.data.planted;
              return (
                <li class="entry" data-row={note.id}>
                  <span class="entry-stem" data-stage={note.data.stage} aria-hidden="true" />
                  <div>
                    <h3>
                      <a href={`/notes/${note.id}`}>{note.data.title}</a>
                    </h3>
                    {note.data.summary && <p>{note.data.summary}</p>}
                    <p class="row-meta">
                      {`${STAGE_META[note.data.stage].label}, ${
                        note.data.tended ? 'tended' : 'planted'
                      } `}
                      <time datetime={isoDate(when)}>{formatDate(when)}</time>
                    </p>
                  </div>
                </li>
              );
            })}
          </ol>

          <a class="band-all" href="/notes">
            All {allNotes.length} notes
          </a>
        </div>
      </section>
    )
  }

  <!-- ============ Posts ============ -->
  {
    posts.length > 0 && (
      <section class="band">
        <div class="container">
          <h2>Finished</h2>
          <p class="band-note">Dated pieces, written once and left alone.</p>

          <ol class="index">
            {posts.map((post) => (
              <li class="entry">
                <span class="entry-stem entry-stem--cut" aria-hidden="true" />
                <div>
                  <h3>
                    <a href={`/posts/${post.id}`}>{post.data.title}</a>
                  </h3>
                  <p>{post.data.summary}</p>
                  <p class="row-meta">
                    {'Published '}
                    <time datetime={isoDate(post.data.published)}>
                      {formatDate(post.data.published)}
                    </time>
                  </p>
                </div>
              </li>
            ))}
          </ol>

          <a class="band-all" href="/posts">
            All {allPosts.length} posts
          </a>
        </div>
      </section>
    )
  }

  <!-- ============ Projects ============ -->
  {
    projects.length > 0 && (
      <section class="band">
        <div class="container">
          <h2>Built</h2>
          <p class="band-note">Things that shipped, or got far enough to be worth keeping.</p>

          <ul class="work work--2">
            {projects.map((project) => (
              <li class="work-item">
                <h3>
                  <a href={`/projects/${project.id}`}>{project.data.title}</a>
                </h3>
                <p>{project.data.summary}</p>
                {project.data.stack.length > 0 && (
                  <p class="work-meta">{project.data.stack.join(', ')}</p>
                )}
              </li>
            ))}
          </ul>

          <a class="band-all" href="/projects">
            All {allProjects.length} projects
          </a>
        </div>
      </section>
    )
  }

  <!-- ============ Links ============ -->
  {
    links.length > 0 && (
      <section class="band">
        <div class="container">
          <h2>Found</h2>
          <p class="band-note">Read elsewhere, kept for the reason underneath.</p>

          <ul class="found">
            {links.map((link) => (
              <li class="found-item">
                <h3>
                  <a href={link.data.url} target="_blank" rel="noopener">
                    {link.data.title}
                  </a>
                </h3>
                {link.data.source && <p class="found-src">{link.data.source}</p>}
                {link.data.note && <p class="found-note">{link.data.note}</p>}
              </li>
            ))}
          </ul>

          <a class="band-all" href="/links">
            All {allLinks.length} links
          </a>
        </div>
      </section>
    )
  }
</Base>

<style>
  /* ---------- hero routes ---------- */
  .routes {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem;
    margin: 0;
  }
  .routes a {
    color: var(--text);
    font-size: var(--t-base);
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 2px solid var(--accent-dim);
    transition: border-color 0.18s var(--ease), color 0.18s var(--ease);
  }
  .routes a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  /* ---------- the index ---------- */
  .band {
    padding: clamp(3rem, 7vw, 4.5rem) 0;
    border-top: 1px solid var(--line);
  }
  .band h2 {
    margin: 0 0 0.35rem;
    font-family: var(--serif);
    font-size: clamp(var(--t-xl), 3.2vw, var(--t-2xl));
    font-weight: 400;
    font-variation-settings: 'opsz' 72;
    letter-spacing: var(--track-tight);
    color: var(--text);
  }
  .band-note {
    margin: 0 0 2.25rem;
    max-width: 56ch;
    font-size: var(--t-base);
    color: var(--text-faint);
  }
  .band-all {
    display: inline-block;
    margin-top: 2.25rem;
    font-size: var(--t-base);
    color: var(--text-dim);
    text-decoration: none;
    border-bottom: 1px solid var(--line-hi);
    padding-bottom: 2px;
    transition: color 0.18s var(--ease), border-color 0.18s var(--ease);
  }
  .band-all:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .index {
    display: grid;
    gap: 2.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .entry {
    display: grid;
    grid-template-columns: 3px 1fr;
    gap: 1.4rem;
  }
  .entry-stem {
    border-radius: 2px;
    background: var(--stem-seedling);
  }
  .entry-stem[data-stage='budding'] {
    background: var(--stem-budding);
  }
  .entry-stem[data-stage='evergreen'] {
    background: var(--stem-evergreen);
  }
  /* Posts are done, so their marker is a stub rather than a full stem. */
  .entry-stem--cut {
    align-self: start;
    height: 1.1rem;
    background: var(--line-hi);
  }

  .entry h3 {
    font-family: var(--serif);
    margin: 0 0 0.45rem;
    font-family: var(--serif);
    font-size: var(--t-md);
    font-weight: 400;
    font-variation-settings: 'opsz' 40;
    line-height: 1.25;
  }
  .entry h3 a {
    color: var(--text);
    text-decoration: none;
    transition: color 0.18s var(--ease);
  }
  .entry h3 a:hover {
    color: var(--accent);
  }
  .entry p {
    margin: 0;
    max-width: 62ch;
    font-size: var(--t-base);
    line-height: 1.6;
    color: var(--text-dim);
  }
  .entry .row-meta {
    margin-top: 0.55rem;
    font-size: var(--t-xs);
    color: var(--text-faint);
  }

  /* ---------- found ---------- */
  .found {
    display: grid;
    gap: 2.3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .found-item h3 {
    font-family: var(--serif);
    margin: 0;
    font-family: var(--serif);
    font-size: var(--t-md);
    font-weight: 400;
    font-variation-settings: 'opsz' 32;
    line-height: 1.3;
  }
  .found-item h3 a {
    color: var(--text);
    text-decoration: none;
    transition: color 0.18s var(--ease);
  }
  .found-item h3 a:hover {
    color: var(--accent);
  }
  .found-src {
    margin: 0.3rem 0 0.75rem;
    font-size: var(--t-xs);
    color: var(--text-faint);
  }
  .found-note {
    margin: 0;
    max-width: 64ch;
    padding-left: 1.1rem;
    border-left: 1px solid var(--line-hi);
    font-family: var(--serif);
    font-variation-settings: 'opsz' 14;
    font-size: var(--t-read);
    line-height: 1.65;
    color: var(--text-dim);
  }

  /* ---------- focus ---------- */
  .hero a:focus-visible,
  .band a:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 4px;
  }

</style>
