---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDate, isoDate } from '../lib/format';

const published = <T extends { data: { draft: boolean } }>(items: T[]) =>
  items.filter((i) => import.meta.env.DEV || !i.data.draft);

const allProjects = published(await getCollection('projects')).sort((a, b) => {
  if (a.data.order !== b.data.order) return a.data.order - b.data.order;
  return (b.data.year ?? 0) - (a.data.year ?? 0);
});
const projects = allProjects.slice(0, 4);

const allLinks = published(await getCollection('links')).sort(
  (a, b) => b.data.added.getTime() - a.data.added.getTime()
);
const links = allLinks.slice(0, 3);
---

<Base title="home">
  <section class="head">
    <div class="container">
      <div class="intro">
        <div>
          <h1>Rajarshi Lahiri</h1>
          <p class="lead">
            I build Salesforce and applied-AI systems. Here: the work, the
            photographs, and the things worth reading that I keep going back to.
          </p>
        </div>
        <!-- The photograph is the one subject five inks genuinely cannot hold,
             which is the whole argument for dithering it. -->
        <div class="portrait">
          <img
            src="/img/photo.jpg"
            alt="Rajarshi Lahiri"
            width="240"
            height="240"
            data-dither="portrait"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="about">
    <div class="container">
      <h2 class="section-title">About</h2>

      <div class="about">
        <div class="prose">
          <p>
            I build <strong>enterprise-grade Salesforce solutions</strong> and
            AI-augmented systems that bridge platform depth with modern machine
            intelligence — Lightning component architecture, Agentforce agent
            design, Data Cloud segmentation, and Python/RAG applications, with a
            consistent emphasis on end-to-end delivery and measurable outcomes.
          </p>
          <p>
            I'm currently a Salesforce Developer and Consultant at
            <strong>Deloitte Consulting</strong>, delivering Sales Cloud, Service
            Cloud Agentforce and Financial Services Cloud engagements for
            enterprise financial services clients — prospect scoring, lead
            handling agents, Data Cloud integration. Before that, enterprise
            development across multi-org environments at Tata Consultancy
            Services.
          </p>
          <p>
            Before the platform work my background was computer vision: two
            Springer publications on neural-network detection problems, and a run
            of projects on pose estimation, accessibility input devices and
            histopathology classification. That grounding is still what shapes how
            I approach applied AI — measure the thing, then believe it.
          </p>
          <p>
            Away from the screen I shoot. Photography and videography are the
            hobby that stuck — a counterweight to work that is mostly
            abstraction, and the reason I notice grain, contrast, and how an image
            falls apart when you push it. Some of it ends up on
            <a href="/photography">the photography page</a>.
          </p>
        </div>

        <dl class="kit">
          <div>
            <dt>Salesforce</dt>
            <dd>
              Sales, Service, Financial Services and Experience Cloud. Apex, LWC,
              Agentforce. Certified Application Architect, Data Architect,
              Agentforce Specialist, and Sharing and Visibility.
            </dd>
          </div>
          <div>
            <dt>Applied AI</dt>
            <dd>
              Python, Agno, FastAPI, ChromaDB. RAG systems, fine-tuned models,
              agentic workflows.
            </dd>
          </div>
          <div>
            <dt>Computer vision</dt>
            <dd>scikit-learn, NumPy, OpenCV, TensorFlow, Matplotlib.</dd>
          </div>
        </dl>
      </div>

      <p class="cv">
        <a class="btn" href="/CV_Rajarshi%20Lahiri.pdf" download>
          <svg class="ico" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d="M8 2.5v7.5M4.75 6.75 8 10l3.25-3.25M3 13h10" />
          </svg>
          Download CV
        </a>
        <span class="cv-meta">PDF</span>
      </p>
    </div>
  </section>

  {
    projects.length > 0 && (
      <section class="section">
        <div class="container">
          <h2 class="section-title">Projects</h2>
          <ul class="rows">
            {projects.map((project) => (
              <li class="row">
                <h3>
                  <a href={`/projects/${project.id}`}>{project.data.title}</a>
                </h3>
                <p>{project.data.summary}</p>
                {project.data.stack.length > 0 && (
                  <p class="row-meta">{project.data.stack.join(' · ')}</p>
                )}
              </li>
            ))}
          </ul>
          {allProjects.length > projects.length && (
            <a class="section-more" href="/projects">
              All {allProjects.length} projects →
            </a>
          )}
        </div>
      </section>
    )
  }

  {
    links.length > 0 && (
      <section class="section">
        <div class="container">
          <h2 class="section-title">Recently read</h2>
          <ul class="rows">
            {links.map((link) => (
              <li class="row">
                <h3>
                  <a href={link.data.url} target="_blank" rel="noopener">
                    {link.data.title}
                    <svg class="out" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                      <path d="M6.5 3.5H12.5V9.5M12.5 3.5L3.5 12.5" />
                    </svg>
                    <span class="sr-only">(opens in a new tab)</span>
                  </a>
                </h3>
                {link.data.note && <p>{link.data.note}</p>}
                <p class="row-meta">
                  {link.data.source && <span>{link.data.source}</span>}
                  <time datetime={isoDate(link.data.added)}>
                    {formatDate(link.data.added)}
                  </time>
                </p>
              </li>
            ))}
          </ul>
          {allLinks.length > links.length && (
            <a class="section-more" href="/links">
              All {allLinks.length} links →
            </a>
          )}
        </div>
      </section>
    )
  }
</Base>

<style>
  .intro {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  /* ---------- about ---------- */
  .about {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  .about .prose {
    max-width: var(--read);
  }

  /* The kit list is reference, not reading: it is set tighter and quieter than
     the prose so the eye can skip it, and scanned by its terms. */
  .kit {
    margin: 0;
    display: grid;
    gap: 1.4rem;
    font-size: var(--t-xs);
  }
  .kit dt {
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 0.35rem;
  }
  .kit dd {
    margin: 0;
    line-height: 1.6;
    color: var(--text-dim);
  }

  .cv {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 2.75rem 0 0;
  }
  .cv-meta {
    font-size: var(--t-xs);
    color: var(--text-faint);
  }
  .ico {
    width: 1em;
    height: 1em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .portrait {
    position: relative;
    width: 180px;
    aspect-ratio: 1;
    max-width: 100%;
  }
  /* No frame, no mask: the ramp's top ink *is* the paper, and the portrait
     vignette in dither.js lifts the edges into it, so the dots simply thin
     out until the photograph is page again. */

  @media (min-width: 46rem) {
    .intro {
      grid-template-columns: 1fr auto;
      gap: 4rem;
    }
    .portrait {
      width: 220px;
    }
    .about {
      grid-template-columns: minmax(0, 1fr) minmax(0, 15rem);
      gap: 4rem;
    }
  }
</style>
