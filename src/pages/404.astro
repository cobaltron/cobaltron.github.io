---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="That path doesn't exist.">
  <section class="head">
    <div class="container">
      <h1>Not found</h1>
      <p class="lead">
        That path doesn't exist — or it did once, and doesn't any more. Try the
        <a href="/projects">projects</a>, the <a href="/photography">photographs</a>,
        or the <a href="/links">links</a>.
      </p>
    </div>
  </section>
</Base>
