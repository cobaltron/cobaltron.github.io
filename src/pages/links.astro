---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDate, isoDate } from '../lib/format';

const all = await getCollection('links');

// Drafts (imported bookmarks awaiting a note) never render in production.
const links = all
  .filter((l) => !l.data.draft)
  .sort((a, b) => b.data.added.getTime() - a.data.added.getTime());

const pending = all.filter((l) => l.data.draft).length;
---

<Base
  title="Links"
  description="A reading list — things worth your time, with notes on why."
>
  <section class="head">
    <div class="container">
      <h1>Links</h1>
      <p class="lead">
        Things I've read that changed how I think about something. The
        commentary is the point — a bare URL is worth nothing six months later.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {import.meta.env.DEV && pending > 0 && (
        <p class="pending">
          {pending} draft{pending === 1 ? '' : 's'} awaiting a note — visible only in dev.
          Add commentary in <code>/keystatic</code> and untick Draft to publish.
        </p>
      )}

      {links.length === 0 ? (
        <div class="empty">
          <p>Nothing collected yet.</p>
          <p>Add links at <code>/keystatic</code> or in <code>src/content/links/</code>.</p>
        </div>
      ) : (
        <ul class="rows">
          {links.map((link) => (
            <li class="row">
              <h2>
                <a href={link.data.url} target="_blank" rel="noopener">
                  {link.data.title}
                  <svg class="out" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <path d="M6.5 3.5H12.5V9.5M12.5 3.5L3.5 12.5" />
                  </svg>
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              </h2>
              <p>{link.data.note}</p>
              <p class="row-meta">
                {link.data.source && <span>{link.data.source}</span>}
                <time datetime={isoDate(link.data.added)}>{formatDate(link.data.added)}</time>
              </p>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Base>

<style>
  .pending {
    border: 1px dashed var(--line-hi);
    padding: 0.9rem 1.1rem;
    margin: 0 0 2rem;
    font-size: var(--t-xs);
    color: var(--text-faint);
  }
  .pending code {
    font-family: var(--code);
  }
</style>
