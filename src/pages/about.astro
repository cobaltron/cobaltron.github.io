---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDate, isoDate } from '../lib/format';

const about = await getEntry('pages', 'about');
const Content = about ? (await render(about)).Content : null;

const roles = (await getCollection('roles')).sort((a, b) => a.data.order - b.data.order);
const publications = (await getCollection('publications')).sort(
  (a, b) => a.data.order - b.data.order
);
const achievements = (await getCollection('achievements')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base
  title="About"
  description="Rajarshi Lahiri — Salesforce developer and applied AI engineer, based in Kolkata."
>
  <section class="hero">
    <div class="container container--read">
      <div class="hero-grid">
        <div>
          <h1>About</h1>
          <p class="hero-lead">
            Salesforce developer and applied AI engineer. I build enterprise platform
            solutions and AI-augmented systems, and I care about how they're delivered
            as much as what they do.
          </p>
          <div class="hero-actions">
            <a class="btn" href="/CV_Rajarshi%20Lahiri.pdf" download>
              <svg class="icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 2v10M4 8.5l4 4 4-4" /></svg> Download CV
            </a>
          </div>
        </div>
        <div class="portrait">
          <img src="/img/photo.jpg" alt="Rajarshi Lahiri" width="240" height="240" data-dither="portrait" />
        </div>
      </div>
    </div>
  </section>

  <!-- Prose from Keystatic -->
  {
    Content && (
      <section class="section">
        <div class="container container--read">
          <div class="prose">
            <Content />
          </div>
        </div>
      </section>
    )
  }

  <!-- Work -->
  {
    roles.length > 0 && (
      <section class="section section--wash">
        <div class="container">
          <div class="section-head">
            <h2 class="section-title">Work</h2>
          </div>

          {roles.map((role) => (
            <article class="role">
              <div class:list={['role-when', { 'is-current': role.data.current }]}>
                {role.data.period}
              </div>
              <div>
                <h3>{role.data.title}</h3>
                <p class="role-org">{role.data.org}</p>
                <p>{role.data.detail}</p>
              </div>
            </article>
          ))}
        </div>
      </section>
    )
  }

  <!-- Publications -->
  {
    publications.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <h2 class="section-title">Publications</h2>
          </div>

          <ul class="work work--2">
            {publications.map((pub) => (
              <li class="work-item">
                <h3>
                  {pub.data.url ? (
                    <a href={pub.data.url} target="_blank" rel="noopener">
                      {pub.data.title}
                    </a>
                  ) : (
                    pub.data.title
                  )}
                </h3>
                <p class="work-meta">
                  {pub.data.venue}
                  {pub.data.year && `, ${pub.data.year}`}
                  {pub.data.isbn && ` — ISBN ${pub.data.isbn}`}
                </p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Achievements -->
  {
    achievements.length > 0 && (
      <section class="section section--wash">
        <div class="container">
          <div class="section-head">
            <h2 class="section-title">Milestones</h2>
          </div>

          <div class="grid grid--3">
            {achievements.map((item) => (
              <article class="shot">
                {item.data.image && (
                  <div class="shot-img">
                    <img src={item.data.image} alt={item.data.title} loading="lazy" decoding="async" data-dither />
                  </div>
                )}
                <div class="shot-body">
                  <h3>{item.data.title}</h3>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    about?.data.updated && (
      <div class="container container--read">
        <p class="updated-stamp">
          Last updated{' '}
          <time datetime={isoDate(about.data.updated)}>{formatDate(about.data.updated)}</time>
        </p>
      </div>
    )
  }
</Base>

<style>

  .updated-stamp {
    font-size: var(--t-xs);
    color: var(--text-faint);
    padding: 2rem 0;
    margin: 0;
  }
</style>
