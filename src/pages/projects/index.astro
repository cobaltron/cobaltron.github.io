---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';

const projects = (await getCollection('projects'))
  .filter((p) => import.meta.env.DEV || !p.data.draft)
  .sort((a, b) => {
    if (a.data.order !== b.data.order) return a.data.order - b.data.order;
    return (b.data.year ?? 0) - (a.data.year ?? 0);
  });
---

<Base title="Projects" description="Things I've built — Salesforce platform work, applied AI systems, and computer vision.">
  <Hero compact>
    <h1>Projects</h1>
    <p class="hero-lead">
      Platform engineering, applied AI, and a long tail of computer vision work
      from earlier on.
    </p>
  </Hero>

  <section class="section">
    <div class="container">
      {
        projects.length === 0 ? (
          <div class="empty">
            <p>No projects yet.</p>
            <p>
              Add one at <code>/keystatic</code> or in <code>src/content/projects/</code>.
            </p>
          </div>
        ) : (
          <ul class="work work--2">
            {projects.map((project) => (
              <li class="work-item">
                <h3>
                  <a href={`/projects/${project.id}`}>{project.data.title}</a>
                </h3>
                <p>{project.data.summary}</p>
                {project.data.stack.length > 0 && (
                  <p class="work-meta">{project.data.stack.join(', ')}</p>
                )}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</Base>
