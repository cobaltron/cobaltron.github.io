---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const projects = (await getCollection('projects'))
  .filter((p) => import.meta.env.DEV || !p.data.draft)
  .sort((a, b) => {
    if (a.data.order !== b.data.order) return a.data.order - b.data.order;
    return (b.data.year ?? 0) - (a.data.year ?? 0);
  });
---

<Base
  title="Projects"
  description="Things I've built — Salesforce platform work, applied AI, and computer vision."
>
  <section class="head">
    <div class="container">
      <h1>Projects</h1>
      <p class="lead">
        Platform engineering, applied AI, and a long tail of computer vision
        work from earlier on.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {
        projects.length === 0 ? (
          <div class="empty">
            <p>No projects yet.</p>
            <p>
              Add one at <code>/keystatic</code> or in <code>src/content/projects/</code>.
            </p>
          </div>
        ) : (
          <ul class="rows">
            {projects.map((project) => (
              <li class="row">
                <h2>
                  <a href={`/projects/${project.id}`}>{project.data.title}</a>
                </h2>
                <p>{project.data.summary}</p>
                <p class="row-meta">
                  {project.data.year && <span>{project.data.year}</span>}
                  {project.data.stack.length > 0 && (
                    <span>{project.data.stack.join(' · ')}</span>
                  )}
                </p>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</Base>
