---
import { getCollection, render } from 'astro:content';
import Entry from '../../layouts/Entry.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects
    .filter((project) => import.meta.env.DEV || !project.data.draft)
    .map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const meta = [
  project.data.role,
  project.data.year ? String(project.data.year) : undefined,
  project.data.stack.length > 0 ? project.data.stack.join(' · ') : undefined,
].filter(Boolean) as string[];
---

<Entry title={project.data.title} summary={project.data.summary} meta={meta}>
  {
    (project.data.repo || project.data.demo) && (
      <p class="project-links">
        {project.data.repo && (
          <a class="btn" href={project.data.repo} target="_blank" rel="noopener">
            Source
          </a>
        )}
        {project.data.demo && (
          <a class="btn" href={project.data.demo} target="_blank" rel="noopener">
            Live demo
          </a>
        )}
      </p>
    )
  }
  <Content />
</Entry>

<style>
  .project-links {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }
</style>
