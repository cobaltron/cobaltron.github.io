---
import { getCollection, render } from 'astro:content';
import Entry from '../../layouts/Entry.astro';
import { getBacklinks } from '../../lib/graph';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects
    .filter((project) => import.meta.env.DEV || !project.data.draft)
    .map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const backlinks = await getBacklinks('projects', project.id);

const meta = [
  project.data.role && { label: 'Role', value: project.data.role },
  project.data.year && { label: 'Year', value: String(project.data.year) },
].filter(Boolean) as { label: string; value: string }[];
---

<Entry
  title={project.data.title}
  summary={project.data.summary}
  kind="project"
  tags={project.data.stack}
  body={project.body}
  backlinks={backlinks}
  meta={meta}
>
  {
    (project.data.repo || project.data.demo) && (
      <p class="project-links">
        {project.data.repo && (
          <a class="btn btn--ghost" href={project.data.repo} target="_blank" rel="noopener">
            <i class="fab fa-github" /> Source
          </a>
        )}
        {project.data.demo && (
          <a class="btn" href={project.data.demo} target="_blank" rel="noopener">
            Live demo
          </a>
        )}
      </p>
    )
  }
  <Content />
</Entry>

<style>
  .project-links {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }
</style>
